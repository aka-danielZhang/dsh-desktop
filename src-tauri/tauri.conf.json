{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-desktop",
  "version": "0.2.0-rc.11",
  "identifier": "dev.dsh.desktop",
  "build": {
    "beforeBuildCommand": "pnpm run desktop:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/aka-danielZhang/dsh-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0NDJGQUExOTA0NEU2N0IKUldSNzVrU1FvZnBDTkhENFJCcDhmWWo4TWczb3BPdlNRUURBa0VGRU1pMWU5TmRjbzBzUXZKNTgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "hardenedRuntime": true,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 196
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 196
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": [
      "resources/runtime.tar.gz",
      "resources/runtime-revision.json",
      "resources/bridge.tar.gz",
      "resources/compaction-hierarchical.tar.gz"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
